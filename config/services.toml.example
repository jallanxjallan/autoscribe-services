# Install as /etc/autoscribe/services.toml and edit the roots for the server.

[paths]
# Git repositories that srv-input may read and srv-writeback may mutate/create.
repo_roots = ["/home/jeremy/Repos"]

# Non-Git input/output files. Keep this list narrow.
# Add the exact Dropbox staging root if/when it is mounted on Biznet.
file_roots = ["/var/lib/autoscribe/files"]

effect_key_file = "/etc/autoscribe/effect.key"
effects_db = "/var/lib/autoscribe/effects.sqlite"
control_db = "/var/lib/autoscribe/control.sqlite"

[limits]
max_record_bytes = 2097152
max_body_bytes = 1048576
max_outputs = 16
max_control_file_bytes = 262144
max_control_records = 10000

[git]
default_branch = "main"
user_name = "AutoScribe"
user_email = "autoscribe@localhost"
