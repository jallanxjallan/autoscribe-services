[Unit]
Description=AutoScribe Dropbox Typst PDF compiler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/flock --no-fork --nonblock /var/lib/autoscribe/typst/service.lock /usr/local/bin/srv-typst /etc/autoscribe/typst.conf
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
MemoryMax=1G
TasksMax=64
Nice=10
TimeoutStopSec=20

[Install]
WantedBy=default.target
